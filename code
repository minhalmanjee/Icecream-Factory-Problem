//icecream shop.h
#ifndef ICECREAM_SHOP_H
#define ICECREAM_SHOP_H

#define FLAVOR_COUNT 3
#define TOPPING_COUNT 2
#define MAX_TICKETS 30

struct ice_cream_shop {
    int tickets;
    int flavors[FLAVOR_COUNT];
    int toppings[TOPPING_COUNT];
    double revenue;
};

#endif


//  icecream_kmod.c 
#include <linux/module.h>
#include <linux/kthread.h>
#include <linux/semaphore.h>
#include <linux/slab.h>
#include <linux/fs.h>
#include <linux/mm.h>
#include <linux/uaccess.h>
#include "icecream_shop.h"

MODULE_LICENSE("GPL");
MODULE_AUTHOR("MinhalManjee");

#define priceFlav_1 1.05
#define priceFlav_2 2.00
#define priceFlav_3 1.67
#define priceTopp_1 0.8
#define priceTopp_2 0.5

static struct ice_cream_shop *shop;
static struct semaphore ticketC, flavorC, toppingC, paymentC;
static struct task_struct *customer_threads[MAX_TICKETS];

// mmap to share shop struct with user-space
static int icecream_mmap(struct file *filp, struct vm_area_struct *vma)
{
    unsigned long pfn = virt_to_phys(shop) >> PAGE_SHIFT;
    if (remap_pfn_range(vma, vma->vm_start, pfn, PAGE_SIZE, vma->vm_page_prot))
        return -EAGAIN;
    return 0;
}

static struct file_operations fops = {
    .owner = THIS_MODULE,
    .mmap  = icecream_mmap
};

// Customer thread simulating one customer
int iceCreamThread(void *_id)
{
    int ID = (int)(long)_id;
    double bill = 0.0;

    // Ticket counter
    down(&ticketC);
    if (shop->tickets <= 0) { up(&ticketC); return 0; }
    shop->tickets--;
    up(&ticketC);

    // Flavor counter
    down(&flavorC);
    if (shop->flavors[0] > 0) { shop->flavors[0]--; bill += priceFlav_1; }
    if (shop->flavors[1] > 0) { shop->flavors[1]--; bill += priceFlav_2; }
    if (shop->flavors[2] > 0) { shop->flavors[2]--; bill += priceFlav_3; }
    up(&flavorC);

    // Topping counter
    down(&toppingC);
    if (shop->toppings[0] > 0) { shop->toppings[0]--; bill += priceTopp_1; }
    if (shop->toppings[1] > 0) { shop->toppings[1]--; bill += priceTopp_2; }
    up(&toppingC);

    // Payment counter
    down(&paymentC);
    shop->revenue += bill;
    up(&paymentC);

    return 0;
}

// Module initialization
static int __init icecream_init(void)
{
    int i;

    shop = kzalloc(sizeof(*shop), GFP_KERNEL);
    shop->tickets = MAX_TICKETS;
    shop->flavors[0] = 29; shop->flavors[1] = 34; shop->flavors[2] = 18;
    shop->toppings[0] = 20; shop->toppings[1] = 34;
    shop->revenue = 0.0;

    sema_init(&ticketC, 1);
    sema_init(&flavorC, 3);
    sema_init(&toppingC, 2);
    sema_init(&paymentC, 1);

    // Spawn 10 threads as demo
    for (i = 0; i < 10; i++)
        customer_threads[i] = kthread_run(iceCreamThread, (void *)(long)(100+i),
                                          "customer_thread_%d", i);

    register_chrdev(240, "icecream", &fops);

    printk("IceCream Shop Kernel Module Loaded\n");
    return 0;
}

// Module exit
static void __exit icecream_exit(void)
{
    int i;
    for (i = 0; i < 10; i++)
        if (customer_threads[i])
            kthread_stop(customer_threads[i]);

    unregister_chrdev(240, "icecream");
    kfree(shop);
    printk("IceCream Shop Kernel Module Unloaded\n");
}

module_init(icecream_init);
module_exit(icecream_exit);


//  user_process.c 
#include <stdio.h>
#include <fcntl.h>
#include <sys/mman.h>
#include "icecream_shop.h"

int main()
{
    int fd = open("/dev/icecream", O_RDWR);
    if (fd < 0) { perror("open"); return 1; }

    struct ice_cream_shop *shop = mmap(NULL, sizeof(*shop),
                                       PROT_READ|PROT_WRITE,
                                       MAP_SHARED, fd, 0);
    if (shop == MAP_FAILED) { perror("mmap"); return 1; }

    printf("Tickets Remaining: %d\n", shop->tickets);
    printf("Flavors Remaining: %d %d %d\n",
           shop->flavors[0], shop->flavors[1], shop->flavors[2]);
    printf("Toppings Remaining: %d %d\n",
           shop->toppings[0], shop->toppings[1]);
    printf("Revenue Collected: %.2f\n", shop->revenue);

    return 0;
}
